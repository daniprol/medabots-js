{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medabots rules definition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "original",
    "tickRate",
    "roundTimeMs",
    "specialMaximum"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string",
      "description": "Globally unique, stable kebab-case content identifier."
    },
    "kind": {
      "const": "rules",
      "type": "string"
    },
    "original": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "breakWave",
        "transformCandidates",
        "speedRows",
        "jumpCurves",
        "sine",
        "battleRandom",
        "partWeights",
        "guardPowerDivisor",
        "readinessMaximum",
        "idleChargeTicks",
        "passiveChargeTicks",
        "chargePulseTicks"
      ],
      "properties": {
        "breakWave": {
          "minItems": 22,
          "maxItems": 22,
          "type": "array",
          "items": {
            "minimum": -8,
            "maximum": 8,
            "type": "integer"
          }
        },
        "transformCandidates": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "change",
            "attackHead",
            "attackArm"
          ],
          "properties": {
            "change": {
              "minItems": 1,
              "type": "array",
              "items": {
                "minimum": 0,
                "maximum": 29,
                "type": "integer"
              }
            },
            "attackHead": {
              "minItems": 1,
              "type": "array",
              "items": {
                "minimum": 0,
                "maximum": 29,
                "type": "integer"
              }
            },
            "attackArm": {
              "minItems": 1,
              "type": "array",
              "items": {
                "minimum": 0,
                "maximum": 29,
                "type": "integer"
              }
            }
          }
        },
        "speedRows": {
          "minItems": 8,
          "maxItems": 8,
          "type": "array",
          "items": {
            "minItems": 9,
            "maxItems": 9,
            "type": "array",
            "items": {
              "minimum": 0,
              "maximum": 40,
              "type": "integer"
            }
          }
        },
        "jumpCurves": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "minItems": 1,
              "maxItems": 128,
              "type": "array",
              "items": {
                "minimum": -16,
                "maximum": 16,
                "type": "integer"
              }
            }
          }
        },
        "sine": {
          "minItems": 360,
          "maxItems": 360,
          "type": "array",
          "items": {
            "minimum": -128,
            "maximum": 127,
            "type": "integer"
          }
        },
        "battleRandom": {
          "minItems": 256,
          "maxItems": 256,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 255,
            "type": "integer"
          }
        },
        "partWeights": {
          "minItems": 8,
          "maxItems": 8,
          "type": "array",
          "items": {
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "minimum": 0,
              "maximum": 100,
              "type": "integer"
            }
          }
        },
        "guardPowerDivisor": {
          "minimum": 1,
          "maximum": 16,
          "type": "integer"
        },
        "readinessMaximum": {
          "minimum": 1,
          "maximum": 1000,
          "type": "integer"
        },
        "idleChargeTicks": {
          "minimum": 1,
          "maximum": 1000,
          "type": "integer"
        },
        "passiveChargeTicks": {
          "minimum": 1,
          "maximum": 1000,
          "type": "integer"
        },
        "chargePulseTicks": {
          "minimum": 1,
          "maximum": 1000,
          "type": "integer"
        }
      }
    },
    "tickRate": {
      "const": 60,
      "type": "number"
    },
    "roundTimeMs": {
      "minimum": 100,
      "maximum": 600000,
      "type": "integer",
      "description": "Duration in milliseconds, rounded up to integer 60Hz simulation ticks."
    },
    "specialMaximum": {
      "const": 51,
      "type": "number"
    }
  }
}
