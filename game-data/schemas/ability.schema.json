{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medabots ability definition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "displayName",
    "abilityKind",
    "delivery",
    "startupMs",
    "activeMs",
    "recoveryMs",
    "damage",
    "staggerMs",
    "knockbackX",
    "knockbackY",
    "projectileSpeed",
    "projectileLifetimeMs",
    "hitbox",
    "specialCost",
    "maxUses",
    "color"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string",
      "description": "Globally unique, stable kebab-case content identifier."
    },
    "kind": {
      "const": "ability",
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "abilityKind": {
      "anyOf": [
        {
          "const": "projectile",
          "type": "string"
        },
        {
          "const": "melee",
          "type": "string"
        },
        {
          "const": "special",
          "type": "string"
        }
      ]
    },
    "delivery": {
      "anyOf": [
        {
          "const": "projectile",
          "type": "string"
        },
        {
          "const": "melee",
          "type": "string"
        }
      ]
    },
    "startupMs": {
      "minimum": 0,
      "maximum": 10000,
      "type": "integer",
      "description": "Delay before the attack becomes active, in milliseconds; rounded up to 60Hz ticks."
    },
    "activeMs": {
      "minimum": 1,
      "maximum": 10000,
      "type": "integer",
      "description": "Duration during which a melee attack can hit. A projectile spawns once at the start."
    },
    "recoveryMs": {
      "minimum": 1,
      "maximum": 10000,
      "type": "integer",
      "description": "Delay after the active period before another attack can start."
    },
    "damage": {
      "minimum": 1,
      "maximum": 1000,
      "type": "number",
      "description": "Armor points removed before guard reduction; damage applies to one overlapping part."
    },
    "staggerMs": {
      "minimum": 0,
      "maximum": 10000,
      "type": "integer",
      "description": "Duration in milliseconds, rounded up to integer 60Hz simulation ticks."
    },
    "knockbackX": {
      "minimum": 0,
      "maximum": 10000,
      "type": "number",
      "description": "Horizontal impact velocity, multiplied by attacker facing."
    },
    "knockbackY": {
      "minimum": 0,
      "maximum": 10000,
      "type": "number",
      "description": "Upward impact velocity in world units per second."
    },
    "projectileSpeed": {
      "minimum": 0.1,
      "maximum": 100,
      "type": "number",
      "description": "Horizontal projectile velocity in world units per second."
    },
    "projectileLifetimeMs": {
      "minimum": 1,
      "maximum": 10000,
      "type": "integer",
      "description": "Duration in milliseconds, rounded up to integer 60Hz simulation ticks."
    },
    "hitbox": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "minimum": -10,
          "maximum": 10,
          "type": "number"
        },
        "y": {
          "minimum": -10,
          "maximum": 10,
          "type": "number"
        },
        "width": {
          "minimum": 0.01,
          "maximum": 10,
          "type": "number"
        },
        "height": {
          "minimum": 0.01,
          "maximum": 10,
          "type": "number"
        }
      },
      "description": "Local center, width and height in world units; X mirrors with facing."
    },
    "specialCost": {
      "minimum": 0,
      "maximum": 10000,
      "type": "number",
      "description": "Meter spent on activation. Normal abilities normally use zero."
    },
    "maxUses": {
      "minimum": 0,
      "maximum": 10000,
      "type": "integer",
      "description": "Uses per battle. Zero means unlimited."
    },
    "color": {
      "pattern": "^#[0-9a-fA-F]{6}$",
      "type": "string"
    }
  }
}
