{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medabots ability definition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "original",
    "displayName",
    "abilityKind",
    "delivery",
    "damage",
    "hitbox",
    "specialCost",
    "maxUses",
    "color"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string",
      "description": "Globally unique, stable kebab-case content identifier."
    },
    "kind": {
      "const": "ability",
      "type": "string"
    },
    "original": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "actionType",
        "category",
        "statusGroup",
        "family",
        "refill",
        "readinessReset",
        "actionTicks",
        "contactTick",
        "shotTick",
        "comboStages",
        "rangePixels",
        "speedPixels",
        "movementAllowed",
        "verified"
      ],
      "properties": {
        "actionType": {
          "minimum": 0,
          "maximum": 34,
          "type": "integer"
        },
        "category": {
          "anyOf": [
            {
              "const": 0,
              "type": "number"
            },
            {
              "const": 1,
              "type": "number"
            },
            {
              "const": 2,
              "type": "number"
            },
            {
              "const": 255,
              "type": "number"
            }
          ]
        },
        "statusGroup": {
          "minimum": 0,
          "maximum": 255,
          "type": "integer"
        },
        "family": {
          "anyOf": [
            {
              "const": "rifle",
              "type": "string"
            },
            {
              "const": "gatling",
              "type": "string"
            },
            {
              "const": "missile",
              "type": "string"
            },
            {
              "const": "sword",
              "type": "string"
            },
            {
              "const": "hammer",
              "type": "string"
            },
            {
              "const": "frame",
              "type": "string"
            },
            {
              "const": "scouting",
              "type": "string"
            },
            {
              "const": "charge",
              "type": "string"
            },
            {
              "const": "beam",
              "type": "string"
            },
            {
              "const": "support",
              "type": "string"
            },
            {
              "const": "barrage",
              "type": "string"
            },
            {
              "const": "vertical-line",
              "type": "string"
            },
            {
              "const": "laser",
              "type": "string"
            },
            {
              "const": "break",
              "type": "string"
            },
            {
              "const": "sacrifice",
              "type": "string"
            },
            {
              "const": "fire",
              "type": "string"
            },
            {
              "const": "thunder",
              "type": "string"
            },
            {
              "const": "freeze",
              "type": "string"
            },
            {
              "const": "hold",
              "type": "string"
            },
            {
              "const": "wave",
              "type": "string"
            },
            {
              "const": "destroy",
              "type": "string"
            },
            {
              "const": "defense",
              "type": "string"
            },
            {
              "const": "full-defense",
              "type": "string"
            },
            {
              "const": "recovery",
              "type": "string"
            },
            {
              "const": "regeneration",
              "type": "string"
            },
            {
              "const": "revive",
              "type": "string"
            },
            {
              "const": "cleanse",
              "type": "string"
            },
            {
              "const": "meter-control",
              "type": "string"
            },
            {
              "const": "confusion",
              "type": "string"
            },
            {
              "const": "ineffective",
              "type": "string"
            },
            {
              "const": "indefensible",
              "type": "string"
            },
            {
              "const": "melee-trap",
              "type": "string"
            },
            {
              "const": "shot-trap",
              "type": "string"
            },
            {
              "const": "change",
              "type": "string"
            },
            {
              "const": "attack-change",
              "type": "string"
            },
            {
              "const": "void-explode",
              "type": "string"
            },
            {
              "const": "void-optic",
              "type": "string"
            },
            {
              "const": "void-gravity",
              "type": "string"
            },
            {
              "const": "all-recovery",
              "type": "string"
            },
            {
              "const": "question",
              "type": "string"
            },
            {
              "const": "double-trap",
              "type": "string"
            },
            {
              "const": "giga-break",
              "type": "string"
            },
            {
              "const": "plus-counter",
              "type": "string"
            },
            {
              "const": "demolition",
              "type": "string"
            },
            {
              "const": "power-drain",
              "type": "string"
            },
            {
              "const": "meltian",
              "type": "string"
            },
            {
              "const": "random-change",
              "type": "string"
            }
          ]
        },
        "refill": {
          "minimum": 0,
          "maximum": 320,
          "type": "integer"
        },
        "readinessReset": {
          "minimum": 0,
          "maximum": 320,
          "type": "integer"
        },
        "actionTicks": {
          "minimum": 1,
          "maximum": 1000,
          "type": "integer"
        },
        "contactTick": {
          "minimum": 0,
          "maximum": 1000,
          "type": "integer"
        },
        "shotTick": {
          "minimum": 0,
          "maximum": 1000,
          "type": "integer"
        },
        "comboStages": {
          "maxItems": 2,
          "description": "Additional right-arm stages, entered only after another B press.",
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "actionTicks",
              "contactTick",
              "shotTick"
            ],
            "properties": {
              "actionTicks": {
                "minimum": 1,
                "maximum": 1000,
                "type": "integer"
              },
              "contactTick": {
                "minimum": 0,
                "maximum": 1000,
                "type": "integer"
              },
              "shotTick": {
                "minimum": 0,
                "maximum": 1000,
                "type": "integer"
              }
            }
          }
        },
        "rangePixels": {
          "minimum": 1,
          "maximum": 1000,
          "type": "integer"
        },
        "speedPixels": {
          "minimum": 0,
          "maximum": 32,
          "type": "integer"
        },
        "movementAllowed": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "displayName": {
      "type": "string"
    },
    "abilityKind": {
      "anyOf": [
        {
          "const": "projectile",
          "type": "string"
        },
        {
          "const": "melee",
          "type": "string"
        },
        {
          "const": "special",
          "type": "string"
        }
      ]
    },
    "delivery": {
      "anyOf": [
        {
          "const": "projectile",
          "type": "string"
        },
        {
          "const": "melee",
          "type": "string"
        }
      ]
    },
    "damage": {
      "minimum": 0,
      "maximum": 1000,
      "type": "number",
      "description": "Armor points removed before guard reduction; damage applies to one overlapping part."
    },
    "hitbox": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "minimum": -10,
          "maximum": 10,
          "type": "number"
        },
        "y": {
          "minimum": -10,
          "maximum": 10,
          "type": "number"
        },
        "width": {
          "minimum": 0.01,
          "maximum": 10,
          "type": "number"
        },
        "height": {
          "minimum": 0.01,
          "maximum": 10,
          "type": "number"
        }
      },
      "description": "Local center, width and height in world units; X mirrors with facing."
    },
    "specialCost": {
      "minimum": 0,
      "maximum": 10000,
      "type": "number",
      "description": "Meter spent on activation. Normal abilities normally use zero."
    },
    "maxUses": {
      "minimum": 0,
      "maximum": 10000,
      "type": "integer",
      "description": "Uses per battle. Zero means unlimited."
    },
    "color": {
      "pattern": "^#[0-9a-fA-F]{6}$",
      "type": "string"
    }
  }
}
