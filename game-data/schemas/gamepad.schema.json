{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medabots gamepad definition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "displayName",
    "axisIndex",
    "verticalAxisIndex",
    "deadzone",
    "activationThreshold",
    "bindings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string",
      "description": "Globally unique, stable kebab-case content identifier."
    },
    "kind": {
      "const": "gamepad",
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "axisIndex": {
      "minimum": 0,
      "maximum": 15,
      "type": "integer",
      "description": "Zero-based browser Gamepad.axes index for horizontal movement."
    },
    "verticalAxisIndex": {
      "minimum": 0,
      "maximum": 15,
      "type": "integer"
    },
    "deadzone": {
      "minimum": 0,
      "maximum": 0.9,
      "type": "number",
      "description": "Ignore stick drift below this absolute value."
    },
    "activationThreshold": {
      "minimum": 0.1,
      "maximum": 1,
      "type": "number",
      "description": "Absolute axis value which becomes digital movement. Must exceed deadzone."
    },
    "bindings": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "moveLeft",
        "moveRight",
        "jump",
        "aimUp",
        "dropThroughPlatform",
        "rightArm",
        "leftArm",
        "head",
        "guard",
        "chargeSpecial",
        "activateSpecial",
        "partnerStrategy",
        "pause"
      ],
      "properties": {
        "moveLeft": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "moveRight": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "jump": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "aimUp": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "dropThroughPlatform": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "rightArm": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "leftArm": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "head": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "guard": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "chargeSpecial": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "activateSpecial": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "partnerStrategy": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        },
        "pause": {
          "minItems": 0,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minimum": 0,
            "maximum": 31,
            "type": "integer"
          }
        }
      },
      "description": "Every action is required. Multiple physical inputs may trigger one action."
    }
  }
}
