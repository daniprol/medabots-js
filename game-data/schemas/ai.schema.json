{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medabots ai definition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "variant",
    "original"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string",
      "description": "Globally unique, stable kebab-case content identifier."
    },
    "kind": {
      "const": "ai",
      "type": "string"
    },
    "variant": {
      "minimum": 0,
      "maximum": 5,
      "type": "integer"
    },
    "original": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "profiles",
        "cooldowns"
      ],
      "properties": {
        "profiles": {
          "minItems": 15,
          "maxItems": 15,
          "type": "array",
          "items": {
            "minItems": 6,
            "maxItems": 6,
            "type": "array",
            "items": {
              "minItems": 7,
              "maxItems": 7,
              "type": "array",
              "items": {
                "minimum": 0,
                "maximum": 255,
                "type": "integer"
              }
            }
          }
        },
        "cooldowns": {
          "minItems": 15,
          "maxItems": 15,
          "type": "array",
          "items": {
            "minItems": 6,
            "maxItems": 6,
            "type": "array",
            "items": {
              "minItems": 4,
              "maxItems": 4,
              "type": "array",
              "items": {
                "minimum": 0,
                "maximum": 1000,
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
