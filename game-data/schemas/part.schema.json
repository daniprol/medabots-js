{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medabots part definition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "originalId",
    "displayName",
    "defense",
    "locomotion",
    "speedIndex",
    "attackRanks",
    "defenseRank",
    "slot",
    "armor"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string",
      "description": "Globally unique, stable kebab-case content identifier."
    },
    "kind": {
      "const": "part",
      "type": "string"
    },
    "originalId": {
      "minimum": 0,
      "maximum": 31,
      "type": "integer"
    },
    "displayName": {
      "type": "string"
    },
    "defense": {
      "minimum": 0,
      "maximum": 255,
      "type": "integer"
    },
    "locomotion": {
      "minimum": 0,
      "maximum": 7,
      "type": "integer"
    },
    "speedIndex": {
      "minimum": 0,
      "maximum": 7,
      "type": "integer"
    },
    "attackRanks": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "minimum": 0,
        "maximum": 5,
        "type": "integer"
      }
    },
    "defenseRank": {
      "minimum": 0,
      "maximum": 5,
      "type": "integer"
    },
    "slot": {
      "anyOf": [
        {
          "const": "head",
          "type": "string"
        },
        {
          "const": "leftArm",
          "type": "string"
        },
        {
          "const": "rightArm",
          "type": "string"
        },
        {
          "const": "legs",
          "type": "string"
        }
      ]
    },
    "armor": {
      "minimum": 0,
      "maximum": 10000,
      "type": "number",
      "description": "Starting armor points. Zero remaining head armor knocks the combatant out."
    },
    "abilityId": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string",
      "description": "Globally unique, stable kebab-case content identifier."
    }
  }
}
