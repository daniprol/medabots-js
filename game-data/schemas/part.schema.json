{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medabots part definition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "slot",
    "armor"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string",
      "description": "Globally unique, stable kebab-case content identifier."
    },
    "kind": {
      "const": "part",
      "type": "string"
    },
    "slot": {
      "anyOf": [
        {
          "const": "head",
          "type": "string"
        },
        {
          "const": "leftArm",
          "type": "string"
        },
        {
          "const": "rightArm",
          "type": "string"
        },
        {
          "const": "legs",
          "type": "string"
        }
      ]
    },
    "armor": {
      "minimum": 1,
      "maximum": 10000,
      "type": "number",
      "description": "Starting armor points. Zero remaining head armor knocks the combatant out."
    },
    "abilityId": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string",
      "description": "Globally unique, stable kebab-case content identifier."
    },
    "movement": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "speed",
        "jumpSpeed",
        "dashSpeed"
      ],
      "properties": {
        "speed": {
          "minimum": 0.1,
          "maximum": 50,
          "type": "number",
          "description": "Maximum running speed in world units per second."
        },
        "jumpSpeed": {
          "minimum": 0.1,
          "maximum": 50,
          "type": "number",
          "description": "Initial upward jump velocity in world units per second."
        },
        "dashSpeed": {
          "minimum": 0.1,
          "maximum": 80,
          "type": "number",
          "description": "Horizontal dash speed in world units per second."
        }
      }
    }
  }
}
