{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medabots keyboard definition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "displayName",
    "bindings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string",
      "description": "Globally unique, stable kebab-case content identifier."
    },
    "kind": {
      "const": "keyboard",
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "bindings": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "moveLeft",
        "moveRight",
        "jump",
        "dropThroughPlatform",
        "rightArm",
        "leftArm",
        "head",
        "guard",
        "chargeSpecial",
        "activateSpecial",
        "partnerStrategy",
        "pause"
      ],
      "properties": {
        "moveLeft": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        },
        "moveRight": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        },
        "jump": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        },
        "dropThroughPlatform": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        },
        "rightArm": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        },
        "leftArm": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        },
        "head": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        },
        "guard": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        },
        "chargeSpecial": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        },
        "activateSpecial": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        },
        "partnerStrategy": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        },
        "pause": {
          "minItems": 1,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Left|Right|Up|Down)|Space|Enter|Escape|Tab|Backspace|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|Numpad([0-9]|Add|Subtract|Multiply|Divide|Decimal|Enter)|Semicolon|Quote|Comma|Period|Slash|Backslash|Bracket(Left|Right)|Minus|Equal|Backquote)$",
            "type": "string"
          }
        }
      },
      "description": "Every action is required. Multiple physical inputs may trigger one action."
    }
  }
}
