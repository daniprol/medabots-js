{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Medabots arena definition",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "displayName",
    "subtitle",
    "width",
    "height",
    "platforms",
    "spawns"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string",
      "description": "Globally unique, stable kebab-case content identifier."
    },
    "kind": {
      "const": "arena",
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "width": {
      "minimum": 10,
      "maximum": 100,
      "type": "number"
    },
    "height": {
      "minimum": 8,
      "maximum": 50,
      "type": "number"
    },
    "platforms": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "x",
          "y",
          "width"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string",
            "description": "Globally unique, stable kebab-case content identifier."
          },
          "x": {
            "minimum": -100,
            "maximum": 100,
            "type": "number"
          },
          "y": {
            "minimum": 0,
            "maximum": 50,
            "type": "number"
          },
          "width": {
            "minimum": 1,
            "maximum": 100,
            "type": "number"
          }
        }
      }
    },
    "spawns": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "minimum": -100,
            "maximum": 100,
            "type": "number"
          },
          "y": {
            "minimum": 0,
            "maximum": 50,
            "type": "number"
          }
        }
      }
    }
  }
}
