// Physical KeyboardEvent.code bindings. All menu presets come from these definitions.
{
  "$schema": "../../schemas/keyboard.schema.json",
  "id": "keyboard-3",
  "kind": "keyboard",
  "displayName": "Shared \u00b7 Numpad",
  "bindings": {
    "moveLeft": ["Numpad4"],
    "moveRight": ["Numpad6"],
    "jump": ["Numpad8"],
    "dropThroughPlatform": ["Numpad5"],
    "rightArm": ["Numpad1"],
    "leftArm": ["Numpad2"],
    "head": ["Numpad3"],
    "guard": ["Numpad0"],
    "chargeSpecial": ["Numpad7"],
    "activateSpecial": ["Numpad9"],
    "partnerStrategy": ["NumpadAdd"],
    "pause": ["NumpadEnter"],
  },
}
