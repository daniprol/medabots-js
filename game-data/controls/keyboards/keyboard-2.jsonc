// Shared keyboard layout. All three shared presets use distinct physical keys.
{
  "$schema": "../../schemas/keyboard.schema.json",
  "id": "keyboard-2",
  "kind": "keyboard",
  "displayName": "Shared · Right side",
  "bindings": {
    "moveLeft": ["ArrowLeft"],
    "moveRight": ["ArrowRight"],
    "jump": ["ArrowUp"],
    "dropThroughPlatform": ["ArrowDown"],
    "rightArm": ["KeyJ"],
    "leftArm": ["KeyK"],
    "head": ["KeyL"],
    "guard": ["ShiftRight"],
    "chargeSpecial": ["KeyU"],
    "activateSpecial": ["KeyO"],
    "partnerStrategy": ["KeyP"],
    "pause": ["Enter"],
  },
}
