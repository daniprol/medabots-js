// Physical KeyboardEvent.code bindings. All menu presets come from these definitions.
{
  "$schema": "../../schemas/keyboard.schema.json",
  "id": "keyboard-solo",
  "kind": "keyboard",
  "displayName": "Solo \u00b7 Arrows + F/G",
  "bindings": {
    "moveLeft": ["ArrowLeft"],
    "moveRight": ["ArrowRight"],
    "jump": ["ArrowUp", "Space"],
    "dropThroughPlatform": ["ArrowDown"],
    "rightArm": ["KeyF"],
    "leftArm": ["KeyG"],
    "head": ["KeyH"],
    "guard": ["ShiftLeft"],
    "chargeSpecial": ["KeyR"],
    "activateSpecial": ["KeyT"],
    "partnerStrategy": ["KeyQ"],
    "pause": ["Escape", "Enter"],
  },
}
