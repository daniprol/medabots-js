{
  "$schema": "../../schemas/keyboard.schema.json",
  "id": "keyboard-solo",
  "kind": "keyboard",
  "displayName": "Solo \u00b7 Arrows + F/G",
  "bindings": {
    "moveLeft": ["ArrowLeft"],
    "moveRight": ["ArrowRight"],
    "jump": ["KeyG"],
    "dropThroughPlatform": ["ArrowDown"],
    "rightArm": ["KeyF"],
    "leftArm": [],
    "head": [],
    "guard": ["KeyD"],
    "chargeSpecial": [],
    "activateSpecial": ["KeyA"],
    "partnerStrategy": ["KeyS"],
    "pause": ["Enter", "Escape"],
    "aimUp": ["ArrowUp"],
  },
}
