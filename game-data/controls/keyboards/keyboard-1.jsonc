// Shared keyboard layout. All three shared presets use distinct physical keys.
{
  "$schema": "../../schemas/keyboard.schema.json",
  "id": "keyboard-1",
  "kind": "keyboard",
  "displayName": "Shared · Left side",
  "bindings": {
    "moveLeft": [
      "KeyA"
    ],
    "moveRight": [
      "KeyD"
    ],
    "jump": [
      "KeyW"
    ],
    "dropThroughPlatform": [
      "KeyS"
    ],
    "rightArm": [
      "KeyF"
    ],
    "leftArm": [
      "KeyG"
    ],
    "head": [
      "KeyH"
    ],
    "guard": [
      "ShiftLeft"
    ],
    "chargeSpecial": [
      "KeyQ"
    ],
    "activateSpecial": [
      "KeyE"
    ],
    "partnerStrategy": [
      "KeyR"
    ],
    "pause": [
      "Escape"
    ]
  }
}
