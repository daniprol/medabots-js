{
  "name": "medabots-ax-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "schemas": "tsx scripts/export-schemas.ts",
    "typecheck": "tsc --noEmit",
