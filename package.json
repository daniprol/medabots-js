{
  "name": "robattle-arena",
  "version": "0.1.0",
  "private": true,
  "description": "An unofficial local robot-battle fan prototype inspired by Medabots AX for Game Boy Advance.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "schemas": "tsx scripts/export-schemas.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm schemas && pnpm notices && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks:install": "lefthook install",
    "prepare": "tsx scripts/install-hooks.ts",
    "notices": "tsx scripts/export-notices.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@sinclair/typebox": "^0.34.41",
    "jsonc-parser": "^3.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.17.0"
}
